# --- secrets & local environment -------------------------------------------
.env
.venv/

# --- raw data: download with `make download` (CC BY-NC-SA 4.0, not redistributed)
data/raw/*
!data/raw/.gitkeep

# --- Power BI CSV exports: regenerate with `make export` ---------------------
powerbi/data/*
!powerbi/data/.gitkeep
# NOTE: *.pbix is deliberately NOT ignored — commit powerbi/olist_dashboard.pbix once built.

# --- Power BI project (PBIP): per-user settings and the data cache, rebuilt on open/refresh
**/.pbi/localSettings.json
**/.pbi/cache.abf

# --- Python / Jupyter ----------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- OS / editor noise -----------------------------------------------------------
.DS_Store
.vscode/
.idea/
